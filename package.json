{
  "name": "paperclip-ghost",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "worker": "node dist/worker.js",
    "start": "node dist/start.js",
    "status": "node dist/start.js --status",
    "install-worker": "npm run build && node scripts/launchd.mjs install",
    "uninstall-worker": "node scripts/launchd.mjs uninstall",
    "ghost:stop": "node scripts/launchd.mjs stop",
    "ghost:start": "node scripts/launchd.mjs start",
    "ghost:test": "node scripts/ghost-test.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "type": "module",
  "private": "true",
  "dependencies": {
    "@sentry/node": "^11.9.0",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "typescript": "^7.0.2"
  }
}
