# Copy to .env. npm run setup writes VISION_MODEL for you.

# Vision model used to look at the screen. Set by npm run setup.
VISION_MODEL=gemma4:e2b

# Optional. Sentry tracing is off unless this is set. Leave empty to keep it off.
SENTRY_DSN=

# Optional. Ollama address, if it is not on this Mac's default port.
# OLLAMA_URL=http://127.0.0.1:11434

# Optional tuning.
# CONTINUE_AFTER_MINUTES=60
# STUCK_MINUTES=20
# HAUNT_UNTIL_HOUR=5
